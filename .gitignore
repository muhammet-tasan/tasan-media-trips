# One-off analysis/scratch scripts
_png_measure.mjs

# Footage-analysis tool output: large/regenerable artifacts stay out of git
# (re-derivable from the raw footage + scripts at any time). Editorial
# write-ups (content_review.md, editorial_editlist.csv, CAPCUT_INSTRUCTIONS.md)
# are NOT regenerable — they're Claude's actual judgment calls — so those
# are deliberately NOT matched here and do get committed.
analysis/*/thumbs/
analysis/*/contact_sheets/
analysis/*/extra_frames/
analysis/*/events/
analysis/*/metadata.json
analysis/*/gallery.html
analysis/*/editlist.csv
analysis/*/events_summary.json

# Per-session notification on/off state (ntfy hooks) — ephemeral, session-scoped,
# recreated as needed; never shared across machines or committed
.claude/notify-state/
