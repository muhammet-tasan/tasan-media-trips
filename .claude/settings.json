{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/notify.py prompt", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/notify.py stop", "timeout": 25 }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/notify.py notification", "timeout": 8 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/notify.py start", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "python3 .claude/hooks/notify.py end", "timeout": 5 }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.claude/notify-state/**)",
      "Bash(touch .claude/notify-state*)",
      "Bash(*notify-state/*)"
    ]
  }
}
